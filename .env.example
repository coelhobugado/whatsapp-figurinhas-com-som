# Copie para .env e ajuste.

# Números que podem usar o bot (DDI + DDD + número, só dígitos), separados por vírgula.
# Número brasileiro sem o 55, ou com/sem o 9 da frente, também é reconhecido.
# Vazio = qualquer pessoa que mandar mensagem ao número do bot.
ALLOWED_NUMBERS=

# Números de quem cuida do bot: podem usar o !atualizar. O próprio número do bot sempre pode.
ADMIN_NUMBERS=

# true = o bot confere ao abrir e a cada 6 horas se há versão nova no GitHub, instala e reinicia sozinho.
# false = só atualiza quando alguém mandar !atualizar. Também dá para mudar mandando
# !atualizar off / !atualizar on ao bot (ele grava aqui).
AUTO_UPDATE=true

# Nome que aparece ao tocar na figurinha (nome do pacote) e autor (opcional).
STICKER_PACK_NAME=Criada por Dexter
STICKER_PUBLISHER=

# Pasta onde fica a sessão do WhatsApp (equivale a estar logado: não compartilhe).
AUTH_DIR=./sessao

# Porta da página local que mostra o QR de vinculação.
QR_PORT=3999

# Pasta dos pedidos pendentes (para retomar depois de uma queda) e do registro de erros. Não compartilhe.
DATA_DIR=./dados

# Quantos pedidos cabem na fila no total (fazendo + esperando).
MAX_PENDING=20

# Quantas figurinhas fazer ao mesmo tempo. Vazio = automático pelo computador (1, 2 ou 3).
MAX_PARALLEL=

# Ao voltar de uma queda (internet, computador desligado), responde pedidos de até quantos minutos atrás.
MAX_MESSAGE_AGE_MINUTES=180

# Máximo de mensagens que o bot envia por minuto (respostas, reações, figurinhas). Responder rápido
# demais a muita gente é o que faz o WhatsApp bloquear números de bot.
MAX_MESSAGES_PER_MINUTE=60

# Caminho do FFmpeg/ffprobe, se não estiverem no PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# true = mostra cada mensagem recebida e o tempo de cada etapa (sem conteúdo nem números).
DEBUG=false

# silent | warn | info | debug — logs internos do Baileys.
LOG_LEVEL=silent
