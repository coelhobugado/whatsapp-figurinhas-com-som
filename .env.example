# Copie para .env e ajuste.

# Números que podem usar o bot (DDI + DDD + número, só dígitos), separados por vírgula.
# Vazio = qualquer pessoa que mandar mensagem ao número do bot.
ALLOWED_NUMBERS=

# Nome que aparece ao tocar na figurinha (nome do pacote) e autor (opcional).
STICKER_PACK_NAME=Criada por Dexter
STICKER_PUBLISHER=

# Pasta onde fica a sessão do WhatsApp (equivale a estar logado: não compartilhe).
AUTH_DIR=./sessao

# Porta da página local que mostra o QR de vinculação.
QR_PORT=3999

# Quantos pedidos podem esperar na fila ao mesmo tempo.
MAX_PENDING=5

# Caminho do FFmpeg/ffprobe, se não estiverem no PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# true = mostra cada mensagem recebida e o tempo de cada etapa (sem conteúdo nem números).
DEBUG=false

# silent | warn | info | debug — logs internos do Baileys.
LOG_LEVEL=silent
